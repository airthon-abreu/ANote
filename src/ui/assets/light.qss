QWidget {
    background-color: #f4f5f7;
    color: #1f2328;
    font-family: "Segoe UI", -apple-system, Roboto, sans-serif;
    font-size: 13px;
}
QSplitter::handle {
    background-color: #d0d7de;
    width: 2px;
}
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}
QListWidget::item {
    padding: 10px;
    border-radius: 6px;
    margin-bottom: 4px;
}
QListWidget::item:hover {
    background-color: #eaeef2;
}
QListWidget::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
    font-weight: bold;
}
QLineEdit, QPlainTextEdit, QTextEdit, QTextBrowser, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 8px;
    color: #1f2328;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #0969da;
}
QPushButton {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 7px 12px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #eaeef2;
    border-color: #afb8c1;
}
QPushButton:disabled {
    background-color: #f6f8fa;
    color: #8c959f;
    border-color: #d0d7de;
}

/* Cabeçalho e Tabela em Alto Contraste */
QHeaderView::section {
    background-color: #eaeef2;
    color: #0969da;
    padding: 8px;
    border: 1px solid #d0d7de;
    font-weight: bold;
    font-size: 13px;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    gridline-color: #d0d7de;
    border-radius: 8px;
    outline: none;
}