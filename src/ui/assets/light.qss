/* =========================================================================
   TEMA CLARO - ALTO CONTRASTE E LEGIBILIDADE
   ========================================================================= */

QWidget {
    background-color: #f6f8fa;
    color: #1f2328;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 13px;
}

/* Divisores e Listas */
QSplitter::handle {
    background-color: #d0d7de;
    width: 2px;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    padding: 4px;
    color: #1f2328;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin-bottom: 3px;
    color: #1f2328;
}

QListWidget::item:hover {
    background-color: #eaeef2;
    color: #0969da;
}

QListWidget::item:selected {
    background-color: #ddf4ff;
    color: #0969da;
    font-weight: bold;
    border: 1px solid #54aeff;
}

/* Campos de Texto e Editores */
QLineEdit, QPlainTextEdit, QTextEdit, QTextBrowser, QSpinBox, QComboBox, QFontComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 8px;
    color: #1f2328;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QFontComboBox:focus {
    border: 1px solid #0969da;
}

/* Botões Gerais */
QPushButton, QToolButton {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
}

QPushButton:hover, QToolButton:hover {
    background-color: #f3f4f6;
    border-color: #8c959f;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #ebecf0;
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #f6f8fa;
    color: #8c959f;
    border-color: #d0d7de;
}

/* Botões Especiais de Formatação Quadrados */
QPushButton#format_btn {
    padding: 0px;
    font-size: 13px;
    font-weight: bold;
}

/* Botões de Recolher / Expandir Painéis */
QPushButton#panel_toggle_btn {
    padding: 2px 6px;
    font-weight: bold;
    border: 1px solid #d0d7de;
    background-color: #ffffff;
}
QPushButton#panel_toggle_btn:hover {
    background-color: #ddf4ff;
    border-color: #0969da;
}

/* Tabela de Atalhos */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    gridline-color: #eaeef2;
    border-radius: 8px;
    color: #1f2328;
    outline: none;
}

QHeaderView::section {
    background-color: #f6f8fa;
    color: #1f2328;
    padding: 8px;
    border: 1px solid #d0d7de;
    font-weight: bold;
    font-size: 13px;
}

/* Barra de Status */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d0d7de;
    color: #57609a;
    font-weight: 500;
}