/* =========================================================================
   ANote - TEMA ESCURO MODERNO (Catppuccin Mocha / Slate)
   ========================================================================= */

QWidget {
    background-color: #181825;
    color: #cdd6f4;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
    font-size: 13px;
}

QLabel {
    background-color: transparent;
}

QSplitter::handle {
    background-color: #313244;
    width: 2px;
}

/* -------------------------------------------------------------
   Barra Superior de Ferramentas
   ------------------------------------------------------------- */
QWidget#top_toolbar {
    background-color: #11111b;
    border-bottom: 1px solid #313244;
}

QWidget#edit_toolbar_group {
    background-color: transparent;
}

QPushButton, QToolButton {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 600;
}

QPushButton:hover, QToolButton:hover {
    background-color: #313244;
    border-color: #45475a;
    color: #ffffff;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #45475a;
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #181825;
    color: #585b70;
    border-color: #262738;
}

QPushButton#btn_primary {
    background-color: #313244;
    border: 1px solid #89b4fa;
    color: #89b4fa;
}
QPushButton#btn_primary:hover {
    background-color: #89b4fa;
    color: #11111b;
}
QPushButton#btn_primary:disabled {
    background-color: #181825;
    border-color: #262738;
    color: #585b70;
}

QPushButton#format_btn {
    background-color: #1e1e2e;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0px;
    font-size: 13px;
}

QPushButton#panel_toggle_btn {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#panel_toggle_btn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

QLabel#unsaved_badge {
    background-color: rgba(249, 226, 175, 0.14);
    color: #f9e2af;
    border: 1px solid #f9e2af;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: bold;
}

/* -------------------------------------------------------------
   Menus e Popups
   ------------------------------------------------------------- */
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 18px 7px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

QMenu::separator {
    height: 1px;
    background: #313244;
    margin: 4px 8px;
}

/* -------------------------------------------------------------
   Campos de Entrada, Caixas de Seleção e Editor
   ------------------------------------------------------------- */
QLineEdit, QTextEdit, QTextBrowser, QComboBox, QFontComboBox, QSpinBox {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 7px;
    color: #cdd6f4;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QFontComboBox:focus, QSpinBox:focus {
    border: 1px solid #89b4fa;
}

QComboBox::drop-down, QFontComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView, QFontComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    selection-background-color: #313244;
    selection-color: #89b4fa;
}

QTextBrowser#reader_canvas {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 10px;
    padding: 0px;
}

QTextEdit#editor_canvas {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
    padding: 20px;
}

QFrame#empty_state_card {
    background-color: #11111b;
    border: 1px dashed #45475a;
    border-radius: 14px;
    padding: 36px;
}

/* -------------------------------------------------------------
   Listas (Cadernos e Termos)
   ------------------------------------------------------------- */
QListWidget {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}

QListWidget::item {
    background-color: transparent;
    padding: 9px 10px;
    border-radius: 6px;
    margin-bottom: 4px;
    color: #cdd6f4;
    border-left: 3px solid transparent;
}

QListWidget::item:hover {
    background-color: #1e1e2e;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #1e1e2e;
    color: #89b4fa;
    font-weight: bold;
    border-left: 3px solid #89b4fa;
}

/* -------------------------------------------------------------
   Barras de Rolagem
   ------------------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 7px;
    margin: 4px 1px 4px 0px;
}

QScrollBar::handle:vertical {
    background: #313244;
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 7px;
    margin: 0px 4px 1px 4px;
}

QScrollBar::handle:horizontal {
    background: #313244;
    min-width: 30px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
}

/* -------------------------------------------------------------
   Tabela de Atalhos e Diálogos
   ------------------------------------------------------------- */
QDialog, QMessageBox {
    background-color: #181825;
    color: #cdd6f4;
}

QTableWidget {
    background-color: #11111b;
    border: 1px solid #313244;
    gridline-color: #1e1e2e;
    border-radius: 8px;
    outline: none;
}

QHeaderView::section {
    background-color: #181825;
    color: #89b4fa;
    padding: 8px;
    border: 1px solid #313244;
    font-weight: bold;
}

QStatusBar {
    background-color: #11111b;
    border-top: 1px solid #313244;
    color: #6c7086;
    font-weight: 500;
}